digraph "Player"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  Node1 [label="{Player\n|+ width\l+ height\l+ colliderWidth\l+ colliderX\l+ colliderHeight\l+ colliderY\l+ leftKey\l+ rightKey\l+ movement\l+ speed\land 11 more...\l|}",height=0.2,width=0.4,color="black", fillcolor="grey75", style="filled", fontcolor="black",tooltip=" "];
  Node2 -> Node1 [color="grey25",fontsize="10",style="solid",label=" +momentum\n+position" ,arrowhead="odiamond"];
  Node2 [label="{Vector\n|+ x\l+ y\l|}",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$struct_vector.html",tooltip=" "];
}
